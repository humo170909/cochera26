# Copiar este archivo como .env.local y completar con los valores del
# proyecto de Supabase (Settings -> API).

# Públicas (seguras de exponer al navegador, protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# PRIVADA: solo se usa en el servidor (creación/edición de usuarios).
# NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
